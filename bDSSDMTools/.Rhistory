folder_path <- "/Users/jorgeassis/Dropbox/Tutoring/Classes & Courses/Modelling the distribution of biodiversity under global change/R-package/bDSSDMTools/R"
r_files <- list.files(path = folder_path,
pattern = "\\.[rR]$", # Match .R or .r at the end
full.names = TRUE,
ignore.case = TRUE) # Pattern itself handles case, but good practice
if (length(r_files) == 0) {
warning("No .R or .r files found in the specified directory: ", folder_path)
} else {
for (file_path in r_files) {
tryCatch({
source(file_path)
}, error = function(e) {
# Report error but continue to next file
warning("Error sourcing file '", basename(file_path), "': ", e$message)
})
}
}
