                           <pdfaType:prefix>author</pdfaType:prefix>
                           <pdfaType:type>AuthorInformation</pdfaType:type>
                           <pdfaType:field>
                              <rdf:Seq>
                                 <rdf:li rdf:parseType="Resource">
