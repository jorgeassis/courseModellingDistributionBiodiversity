
library(terra)
library(ecospat)
library(dismo)
library(nicheROVER)
library(ade4)

source("../Sessions practice/Session-P-S09-functions.R")

# load environmental predictors
environment <- rast(list.files(path = "../Data/Raster data", pattern = "Present Surface", full.names = TRUE))
names(environment) <- c("Nitrate","Temperature Max.","Temperature Min")

plot(environment)

# load binary SDM outputs
speciesA <- rast("../Data/Raster data/Laminaria hyperborea Suitability.tif")
speciesB <- rast("../Data/Raster data/Laminaria ochroleuca Suitability.tif")

names(speciesA) <- "Laminaria hyperborea"
names(speciesB) <- "Laminaria ochroleuca"

plot(speciesA, col=c("Yellow","Black"))
plot(speciesB, col=c("Yellow","Black"))

# Computes different metrics from a probabilistic method for quantifying n-dimensional niches

data <- prepareDataNicheOverlap(environment,speciesA,speciesB)
repetitions <- 100
colorsGroups <- c("grey", "red")

# plot niche overlap
plotNicheOverlap(data,repetitions)

# determine niche size
nicheSize(data,repetitions)

# determine mean niche overlap
meanNicheOverlap(data,repetitions,colorsGroups)
dev.off()

# Compute index of niche overlap: Schoener's D and I is a modified Hellinger metric (Warren et al. 2008)
# Schoener, T.W. 1968. Anolis lizards of Bimini: resource partitioning in a complex fauna. Ecology, 49, 704-726.
# Warren, D.L., R.E. Glor and M. Turelli. 2008. Environmental niche equivalency versus conservatism: quantitative approaches to niche evolution. Evolution, 62, 2868-2883.

grid.clim <- prepareDataNicheOverlap2(environment,speciesA,speciesB)
ecospat.niche.overlap(grid.clim$grid.clim.sp.1, grid.clim$grid.clim.sp.2, cor=F)

# Run a niche equivalency test based on two species occurrence density grids
# It is recommended to use at least 1000 replications for the equivalency test.
# Niche equivalency test H1: Is the overlap between niches higher than two random niches?

eq.test <- ecospat.niche.equivalency.test(grid.clim$grid.clim.sp.1, grid.clim$grid.clim.sp.2,rep=1000)
eq.test$p.D
eq.test$p.I

# Niche similarity test (see Warren et al 2008) based on two species occurrence density grids.
# Shifting randomly the invasive niche in the invaded study area.
# It is recommended to use at least 1000 replications for the similarity test.
# Niche similarity test H1: Is the overlap between niches higher than when one species is randomly introduced in the other species study area?

sim.test <- ecospat.niche.similarity.test(grid.clim$grid.clim.sp.1, grid.clim$grid.clim.sp.2, rep=1000)
sim.test$p.D
sim.test$p.I

