
install.packages(c("corrplot"))
devtools::install_github("bio-oracle/biooracler")
install.packages("https://github.com/jorgeassis/courseModellingDistributionBiodiversity/raw/refs/heads/main/bDSSDMTools_0.0.0.9000.tar.gz")

library(bDSSDMTools)
library(terra)

recordsObis <- getExternalDataObis(taxa = "Laminaria ochroleuca", getCitation = TRUE)
recordsGbif <- getExternalDataGbif(taxa = "Volucella bombylans", getCitation = TRUE)

# merge data

records <- rbind(recordsGbif, recordsObis)

head(records)

# purge NAs

recordsSubset <- records[ ! ( is.na(records$Lon) | is.na(records$Lat) ) , ]

sum(is.na(recordsSubset$Lon))

# test for duplicates

recordsSubset2 <- recordsSubset[ ! duplicated( recordsSubset[ , c("Lon","Lat") ] ) , ]

nrow(recordsSubset2)

# transform data.frame into a spatial object
recordsFinal <- vect(recordsSubset2, geom = c("Lon", "Lat"))

# make plot
landmass <- vect("../Data/Vector data/Landmass/landmass.shp")

# plot the landmass and the records
plot(landmass, main = "Species occurrence records", col = "Gray", border = "Gray", axes = TRUE)
plot(recordsFinal, col = "Black", pch = 19, cex = 0.5, add = TRUE)



# Load necessary libraries
library(leaflet)
library(mapedit)

# create a base leaflet map
baseMap <- leaflet()
baseMap <- addTiles(baseMap)

# drawing vector polygon in the Viewer pane
myRegion <- drawFeatures(baseMap)

myRegion <- vect(myRegion)
# intersect the records with the region
recordsFinal <- intersect(recordsFinal, myRegion)
# inspect the class of the object
class(recordsFinal)

bathymetry <- rast("../Data/Raster data/Bathymetry.tif")
depthDistribution <- extract(bathymetry, recordsFinal)

hist(depthDistribution$Bathymetry, breaks = 1000)


recordsFinal <- recordsFinal[ depthDistribution$Bathymetry > -30 & ! is.na(depthDistribution$Bathymetry) , ]

