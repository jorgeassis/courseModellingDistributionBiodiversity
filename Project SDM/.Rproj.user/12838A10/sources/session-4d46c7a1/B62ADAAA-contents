

landmass <- vect("../Data/Vector data/Landmass/landmass.shp")

# Load necessary libraries
library(leaflet)
library(mapedit)

# create a base leaflet map
baseMap <- leaflet()
baseMap <- addTiles(baseMap)

# drawing vector polygon in the Viewer pane
drawnFeatures <- drawFeatures(baseMap)

plot(landmass, col = "Gray", border = "Gray", axes = TRUE, ylab = "Latitude", xlab = "Longitude")
plot(drawnFeatures, col = "Black", pch = 20, add = TRUE)

class(drawnFeatures)
drawnFeatures_vect <- vect(drawnFeatures)
class(drawnFeatures_vect)

writeVector(x = drawnFeatures_vect, filename = "output_name.shp", filetype = "ESRI Shapefile", overwrite = TRUE)
