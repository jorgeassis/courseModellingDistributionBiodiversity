library(nicheROVER)
library(ade4)
source("../Sessions practice/Session-P-S09-functions.R")
# load environmental predictors
environment <- rast(list.files(path = "../Data/Raster data", pattern = "Present Surface", full.names = TRUE))
names(environment) <- c("Nitrate","Temperature Max.","Temperature Min")
plot(environment)
# load binary SDM outputs
speciesA <- rast("../Data/Raster data/Laminaria hyperborea Suitability.tif")
speciesB <- rast("../Data/Raster data/Laminaria ochroleuca Suitability.tif")
names(speciesA) <- "Laminaria hyperborea"
names(speciesB) <- "Laminaria ochroleuca"
plot(speciesA, col=c("Yellow","Black"))
plot(speciesB, col=c("Yellow","Black"))
data <- prepareDataNicheOverlap(environment,speciesA,speciesB)
repetitions <- 100
colorsGroups <- c("grey", "red")
# plot niche overlap
plotNicheOverlap(data,repetitions)
# determine niche size
nicheSize(data,repetitions)
# determine mean niche overlap
meanNicheOverlap(data,repetitions,colorsGroups)
grid.clim <- prepareDataNicheOverlap2(environment,speciesA,speciesB)
dev.off()
grid.clim <- prepareDataNicheOverlap2(environment,speciesA,speciesB)
ecospat.niche.overlap(grid.clim$grid.clim.sp.1, grid.clim$grid.clim.sp.2, cor=F)
eq.test <- ecospat.niche.equivalency.test(grid.clim$grid.clim.sp.1, grid.clim$grid.clim.sp.2,rep=100)
eq.test$p.D
eq.test$p.I
sim.test <- ecospat.niche.similarity.test(grid.clim$grid.clim.sp.1, grid.clim$grid.clim.sp.2, rep=100)
sim.test$p.D
sim.test$p.I
